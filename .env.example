# Google Gemini API Configuration (100% Free - Get key from: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Agent Server Configuration
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_SECRET_TOKEN=your_laravel_agent_shared_secret

# SSH Credentials (if connecting to remote servers)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# Valkey / Redis In-Memory Store Configuration (Default: 192.168.20.152:6379 or 127.0.0.1:6379)
VALKEY_HOST=192.168.20.152
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
